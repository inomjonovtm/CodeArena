# ---- Django
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Produksiyada (DJANGO_DEBUG=False) kamida 32 belgi bo'lishi SHART — aks holda
# server ishga tushmaydi.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# ---- Ma'lumotlar bazasi (PostgreSQL — majburiy, boshqa baza qo'llanmaydi)
# Produksiyada (DJANGO_DEBUG=False) standart parol bilan server ishga
# TUSHMAYDI. Kuchli parol: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Ulanishni qayta ishlatish muddati (soniya). 0 — har so'rovda yangi ulanish.
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# ---- Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ---- JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# ---- CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# ---- Lokal judge (Judge0 ishlamayotganda zaxira)
# Kodni Docker izolyatsiyasisiz, shu serverda bajaradi. Bu TO'LIQ SANDBOX EMAS:
# tarmoq va fayl tizimi bloklanmagan (apps/judge/runner.py dagi izohga qarang).
# DEBUG=True da sukut bo'yicha yoqilgan, produksiyada — o'chirilgan.
# Ishonchsiz foydalanuvchilar kodi uchun produksiyada FAQAT Judge0 ishlatilsin.
LOCAL_JUDGE_ENABLED=False

# ---- Limitlar
SUBMISSION_RATE=10/min
AUTH_RATE=20/min
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_KB=262144
PLAGIARISM_THRESHOLD=0.85

# ---- Fayl yuklash (avatar, muqova)
MAX_UPLOAD_SIZE_MB=5

# ---- Email (bo'sh qoldirilsa xatlar konsolga chiqadi)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CodeArena <no-reply@codearena.uz>

# ---- Google orqali kirish (bo'sh bo'lsa tugma ko'rinmaydi)
GOOGLE_CLIENT_ID=

# ---- Brauzer push xabarlari (Web Push / VAPID)
# Kalitlarni yaratish: python manage.py vapid_keys
# Bo'sh qoldirilsa push butunlay o'chadi va interfeysda tugma ko'rinmaydi.
# DIQQAT: kalit almashtirilsa mavjud barcha obunalar kuchini yo'qotadi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@codearena.uz
PUSH_MAX_FAILURES=5

# Musobaqa boshlanishidan necha daqiqa oldin eslatma yuboriladi
CONTEST_REMINDER_MINUTES=30

# ---- HTTPS (faqat DJANGO_DEBUG=False bo'lganda ta'sir qiladi)
SECURE_SSL_REDIRECT=True
# Domen HTTPS'da barqaror ishlagach True qiling — preload'dan chiqish qiyin
SECURE_HSTS_PRELOAD=False
