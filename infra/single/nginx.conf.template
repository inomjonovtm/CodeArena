# Yagona konteyner ichidagi nginx. `${PORT}` entrypoint'da envsubst bilan
# almashtiriladi — hosting platformalari portni muhit o'zgaruvchisi orqali
# beradi va u har deployda boshqacha bo'lishi mumkin.
#
# Bu fayl `conf.d/` ichiga tushadi, ya'ni `http` konteksti ichida — shuning
# uchun `map` shu yerda e'lon qilinadi.

upstream django {
    server 127.0.0.1:8000;
}

upstream nextjs {
    server 127.0.0.1:3000;
}

# Platformaning edge proksisi HTTPS'ni tugatib, `X-Forwarded-Proto` yuboradi.
# Uni saqlamasak, Django `SECURE_SSL_REDIRECT` tufayli so'rovni cheksiz
# HTTPS'ga yo'naltirib turardi: edge HTTPS deb bilardi, ichkariga esa HTTP
# kelardi. Sarlavha bo'lmasa — konteynerga kelgan sxema ishlatiladi.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;

    client_max_body_size 10M;

    # Loglar platformaning log oqimiga tushsin, konteyner ichidagi faylga emas.
    access_log /dev/stdout;
    error_log  /dev/stderr;

    location /static/ {
        alias /app/backend/staticfiles/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /app/backend/media/;
        expires 7d;
    }

    # `/api/` to'g'ridan-to'g'ri Django'ga — Next'ning rewrite'i orqali
    # o'tkazish ortiqcha sakrash bo'lardi. Oxirgi slash saqlanadi:
    # backendda `APPEND_SLASH = False`.
    location /api/ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 120s;

        # Musobaqa natijalari SSE orqali oqadi — buferlash yoqilsa,
        # hodisalar ulanish yopilgunicha ushlanib qolardi.
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
    }

    location /health/ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://nextjs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
