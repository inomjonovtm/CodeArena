{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8001"],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "codearena-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "codearena-site",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
