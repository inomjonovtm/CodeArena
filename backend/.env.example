# ---- Django
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Produksiyada (DJANGO_DEBUG=False) kamida 32 belgi bo'lishi SHART — aks holda
# server ishga tushmaydi.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# ---- Ma'lumotlar bazasi (PostgreSQL — majburiy, boshqa baza qo'llanmaydi)
# Produksiyada (DJANGO_DEBUG=False) standart parol bilan server ishga
# TUSHMAYDI. Kuchli parol: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Ulanishni qayta ishlatish muddati (soniya). 0 — har so'rovda yangi ulanish.
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# ---- Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ---- JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# ---- CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# ---- Lokal judge (Judge0 ishlamayotganda zaxira)
# Kodni Docker izolyatsiyasisiz, shu serverda bajaradi. Bu TO'LIQ SANDBOX EMAS:
# tarmoq va fayl tizimi bloklanmagan (apps/judge/runner.py dagi izohga qarang).
# DEBUG=True da sukut bo'yicha yoqilgan, produksiyada — o'chirilgan.
# Ishonchsiz foydalanuvchilar kodi uchun produksiyada FAQAT Judge0 ishlatilsin.
LOCAL_JUDGE_ENABLED=False

# Lokal judge kompilyator/interpretatorni qidiradigan QO'SHIMCHA kataloglar.
# Tizim PATH'iga qo'shilmagan toolchain uchun (Windowsda MinGW odatda shunday).
# Bir nechtasi `;` (Windows) yoki `:` (Linux) bilan ajratiladi.
#   Windows:  JUDGE_BIN_DIRS=C:/Users/<siz>/msys64/ucrt64/bin
#   Linux:    JUDGE_BIN_DIRS=/usr/lib/gcc/x86_64-linux-gnu/13
JUDGE_BIN_DIRS=

# ---- Limitlar (rate limit)
# `anon`/`user` — BARCHA endpointlarga qo'llanadigan umumiy tom.
ANON_RATE=90/min
USER_RATE=600/min
SUBMISSION_RATE=10/min
AUTH_RATE=20/min
# Parolni tiklash: IP bo'yicha va so'ralgan EMAIL bo'yicha alohida.
# Ikkinchisi IP almashtirib bitta manzilga xat yog'dirishni to'sadi.
PASSWORD_RESET_RATE=5/hour
PASSWORD_RESET_TARGET_RATE=3/hour
EMAIL_SEND_RATE=5/hour
SOCIAL_AUTH_RATE=20/min
CONTENT_WRITE_RATE=30/min
CLIENT_ERROR_RATE=20/hour
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_KB=262144
PLAGIARISM_THRESHOLD=0.85

# ---- Fayl yuklash (avatar, muqova)
MAX_UPLOAD_SIZE_MB=5

# ---- Email (bo'sh qoldirilsa xatlar konsolga chiqadi)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CodeArena <no-reply@codearena.uz>

# ---- Google orqali kirish (bo'sh bo'lsa tugma ko'rinmaydi)
GOOGLE_CLIENT_ID=

# ---- Brauzer push xabarlari (Web Push / VAPID)
# Kalitlarni yaratish: python manage.py vapid_keys
# Bo'sh qoldirilsa push butunlay o'chadi va interfeysda tugma ko'rinmaydi.
# DIQQAT: kalit almashtirilsa mavjud barcha obunalar kuchini yo'qotadi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@codearena.uz
PUSH_MAX_FAILURES=5

# Musobaqa boshlanishidan necha daqiqa oldin eslatma yuboriladi
CONTEST_REMINDER_MINUTES=30

# ---- HTTPS (faqat DJANGO_DEBUG=False bo'lganda ta'sir qiladi)
SECURE_SSL_REDIRECT=True
# Domen HTTPS'da barqaror ishlagach True qiling — preload'dan chiqish qiyin
SECURE_HSTS_PRELOAD=False

# ---- Loglar
# `json` — produksiya uchun: har yozuv bitta JSON obyekti, `request_id` bilan.
# `simple` — odam o'qiydigan matn (ishlab chiqish uchun sukut).
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---- Sentry (xatolarni kuzatish)
# Bo'sh bo'lsa BUTUNLAY o'chadi — hech qanday tashqi so'rov ketmaydi.
# Busiz produksiyadagi 500 xatosi faqat konteyner logida qolib ketadi.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0

# ---- Zaxira (backup)
# Rejaga ko'ra kunlik zaxira. Produksiyada YOQILISHI shart, aks holda
# zaxira faqat kimdir admin paneldan tugma bosganda olinadi.
BACKUP_SCHEDULE_ENABLED=True
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=30
BACKUP_KEEP=10
# Tashqi nusxa (S3-mos xotira). Bo'sh bo'lsa faqat lokal nusxa qoladi —
# server yo'qolsa zaxira ham u bilan ketadi.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---- Media fayllarni saqlash
# `local` — konteyner diski (bitta serverda ishlaydi).
# `s3` — obyekt xotirasi (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
#        Bir nechta backend nusxasi bo'lsa yoki fayllar yo'qolmasligi
#        kerak bo'lsa shu variant tanlanadi.
MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2/MinIO uchun; AWS S3 da bo'sh qoldiriladi
AWS_S3_ENDPOINT_URL=
# CDN domeni (bo'lsa MEDIA_URL shundan quriladi)
AWS_S3_CUSTOM_DOMAIN=
